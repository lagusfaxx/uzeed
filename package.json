{
  "name": "uzeed-only-mvp",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "pnpm exec prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "pnpm exec prisma studio --schema=prisma/schema.prisma",
    "seed": "pnpm --filter @uzeed/api seed"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}

