# Server
PORT=3001
NODE_ENV=development

# Frontend origin (dev: http://localhost:3000)
APP_URL=http://localhost:3000

# Public API base URL (used to build callback URLs)
API_URL=http://localhost:3001

# Cookies
SESSION_SECRET=change-me-very-long-random
COOKIE_DOMAIN=

# DB
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/onlymvp?schema=public

# Khipu
# x-api-key header for Khipu Payment API (Instant v3) and Automatic Payments API (v1).
# IMPORTANT: Automatic Payments is a separate Khipu product and may need to be enabled for your account.
KHIPU_API_KEY=
# Merchant secret used to verify x-khipu-signature webhook header
KHIPU_MERCHANT_SECRET=

# Automatic Payments (recommended for auto monthly billing)
KHIPU_SUBSCRIPTION_RETURN_URL=http://localhost:3000/billing/subscription/return
KHIPU_SUBSCRIPTION_CANCEL_URL=http://localhost:3000/billing/subscription/cancel
KHIPU_SUBSCRIPTION_NOTIFY_URL=http://localhost:3001/billing/khipu/subscription-notify
KHIPU_CHARGE_NOTIFY_URL=http://localhost:3001/billing/khipu/charge-notify
KHIPU_MAX_AMOUNT_CLP=30000

# Instant Payments (kept for fallback/testing)
KHIPU_RETURN_URL=http://localhost:3000/billing/return
KHIPU_NOTIFY_URL=http://localhost:3001/billing/khipu/notify
MEMBERSHIP_DAYS=30
MEMBERSHIP_PRICE_CLP=1990

# Email (demo SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="UZEED <no-reply@uzeed.cl>"
